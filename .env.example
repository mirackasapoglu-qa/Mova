# --- Baglanti ---
# OPRAS gateway adresi. Koleksiyon varsayilani http://localhost:7000 (lokal);
# CI ve ekip kosumlari icin deploy edilmis dev/staging adresini yaz.
BASE_URL=
TIMEOUT=15

# Multi-tenant gateway: her istek tenant baglamini x-tenant-id ile tasir.
TENANT_ID=DEMO_TENANT

# --- Auth (OTP akisi) ---
# Sira: ACCESS_TOKEN varsa dogrudan kullanilir; yoksa TEST_EMAIL + OTP_CODE ile
# /v1/auth/otp/request -> /v1/auth/otp/verify kosulur. Ikisi de yoksa authli
# testler SKIP edilir (sessizce PASS gecmez).
TEST_EMAIL=
# Dev ortamindaki sabit/bypass OTP kodu
OTP_CODE=
# Alternatif: hazir accessToken (OTP akisini tamamen atlar)
ACCESS_TOKEN=

# --- Negatif senaryolar (kayitli OLMAYAN deger) ---
UNKNOWN_EMAIL=nonexistent_user_qa@example.com

# --- Jira (opsiyonel — panel ve RAG senkronu icin) ---
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
